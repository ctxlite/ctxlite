{
  "name": "@ctxlite/opencode",
  "version": "0.1.26",
  "license": "SEE LICENSE IN LICENSE",
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/techdebeci"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "default": "./dist/tui.tsx"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc --build && mkdir -p dist && cp src/tui.tsx dist/tui.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json"
  },
  "dependencies": {
    "@ctxlite/core": "0.1.26",
    "@opencode-ai/plugin": "latest",
    "@opentui/core": "^0.2.16",
    "@opentui/solid": "^0.2.16",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
